# The base image is pinned by digest. The tag is there for readability.
FROM python:3.13-slim-trixie@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

# The service uses only the standard library, so no packages are installed.
# pip is removed because nothing in the running container needs it, and the
# libraries bundled inside it carry known vulnerabilities.
# The user is numeric, has no login shell and no home directory.
RUN python -m pip uninstall --yes pip \
 && groupadd --gid 10001 app \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app

# Owned by root and read-only for everyone, so the app user cannot modify it.
COPY --chown=root:root app.py /app/app.py
RUN chmod 0444 /app/app.py

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

# Secrets are not set here. Inject them at run time, for example as a file
# mounted from a secret manager, and point DB_PASSWORD_FILE at it.

USER 10001:10001

# Unprivileged port, so no capability is needed to bind it.
EXPOSE 8080

# Uses the Python interpreter already in the image instead of curl.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import os, urllib.request as u; u.urlopen('http://127.0.0.1:' + os.environ.get('PORT', '8080') + '/healthz', timeout=2)"]

CMD ["python", "/app/app.py"]
